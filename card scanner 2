function parseLine(l){
  let p;
  if(l.includes('|'))p=l.split('|');
  else if(l.includes(':'))p=l.split(':');
  else if(l.includes('\t'))p=l.split('\t');
  else p=l.split(/\s{2,}/);
  if(p.length<4)p=l.split(/\s+/);
  return p.map(s=>(s||'').trim());
}

