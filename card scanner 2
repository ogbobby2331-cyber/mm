async function hmac(k,m){
  const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(k),
    {name:'HMAC',hash:'SHA-256'},false,['sign']);
  const mac=await crypto.subtle.sign('HMAC',key,new TextEncoder().encode(m));
  return [...new Uint8Array(mac)].map(b=>b.toString(16).padStart(2,'0')).join('');
}
